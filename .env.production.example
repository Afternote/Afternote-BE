# Copy to .env.production on the deploy host (not committed).
# docker compose --env-file .env.production up -d

SPRING_PROFILES_ACTIVE=prod

# Database (RDS)
DB_URL=jdbc:mysql://your-rds-endpoint:3306/afternote?serverTimezone=Asia/Seoul&characterEncoding=UTF-8&useSSL=true
DB_USERNAME=
DB_PASSWORD=

# Redis
REDIS_HOST=
REDIS_PORT=6379

# JWT
JWT_SECRET=
JWT_ACCESS_EXPIRATION=
JWT_REFRESH_EXPIRATION=

# Encryption / OAuth / AI
CHACHA20_SECRET_KEY=
GOOGLE_WEB_CLIENT_ID=
GEMINI_API_KEY=

# AWS S3
AWS_S3_BUCKET=
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_PUBLIC_BASE_URL=
# Optional upload size caps (bytes). Defaults: image 10MB / video 200MB / audio 50MB / document 20MB
# S3_UPLOAD_MAX_BYTES_IMAGE=
# S3_UPLOAD_MAX_BYTES_VIDEO=
# S3_UPLOAD_MAX_BYTES_AUDIO=
# S3_UPLOAD_MAX_BYTES_DOCUMENT=

# Mail (optional)
EMAIL=
EMAIL_PASSWORD=

# CORS
CORS_ALLOWED_ORIGINS=https://your-frontend-domain

# Admin bootstrap (required for /api/v1/admin/* APIs)

# App version seed (first row when app_version_release is empty)
APP_ANDROID_SEED_VERSION_CODE=10001
APP_ANDROID_SEED_VERSION_NAME=1.0.0
APP_ANDROID_STORE_URL=http://your-playstore-domain

ADMIN_EMAIL=admin@afternote.com
ADMIN_PASSWORD=admin1234
