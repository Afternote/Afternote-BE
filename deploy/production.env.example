# Copy to deploy/production.env (gitignored), fill secrets, then:
#   ./scripts/push-deploy-env-secret.sh
# Deploy workflow writes this to EC2 ~/deploy/.env

# Database
DB_NAME=afternote
DB_PASSWORD=
DB_PORT=3306
DB_USERNAME=
DB_URL=jdbc:mysql://YOUR_RDS:3306/afternote?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
JWT_ACCESS_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=604800000
JWT_SECRET=
SERVER_PORT=8080
SPRING_PROFILE=default
REDIS_HOST=afternote-redis
REDIS_PORT=6379
EMAIL=
EMAIL_PASSWORD=
CORS_ALLOWED_ORIGINS=https://your-frontend-domain
CHACHA20_SECRET_KEY=
AWS_S3_BUCKET=
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_PUBLIC_BASE_URL=
SPRING_PROFILES_ACTIVE=prod
GEMINI_API_KEY=
GOOGLE_WEB_CLIENT_ID=
APP_ANDROID_SEED_VERSION_CODE=10001
APP_ANDROID_SEED_VERSION_NAME=1.0.0
APP_ANDROID_STORE_URL=https://play.google.com/store/apps/details?id=your.app
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
# Firebase FCM (서비스 계정 JSON 전체 — google-services.json 과 다른 파일)
FIREBASE_PROJECT_ID=afternote-7471f
FIREBASE_ANDROID_PACKAGE_NAME=com.afternote.app
FIREBASE_SERVICE_ACCOUNT_JSON=
# Passkeys (앱 서명 SHA-256. debug/release 는 쉼표로 여러 개.
# 같은 값이 assetlinks 와 Android apk-key-hash origin 에 쓰인다.)
PASSKEY_RP_ID=afternote.kro.kr
PASSKEY_ORIGIN=https://afternote.kro.kr
PASSKEY_ANDROID_PACKAGE_NAME=com.afternote.afternote_fe
PASSKEY_ANDROID_SHA256=
# Sentry (error monitoring only)
SENTRY_DSN=https://YOUR_PUBLIC_KEY@oNNNN.ingest.us.sentry.io/PROJECT_ID
SENTRY_ENVIRONMENT=prod
SENTRY_SEND_DEFAULT_PII=false
