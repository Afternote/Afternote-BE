# Copy to terraform.tfvars and fill in YOUR values (terraform.tfvars is gitignored)
#
#   cp terraform.tfvars.example terraform.tfvars

aws_region   = "ap-northeast-2"
project_name = "afternote"
environment  = "dev"

# Existing EC2 key pair name in the region (NOT the .pem filename)
# aws ec2 describe-key-pairs --query 'KeyPairs[].KeyName'
ec2_key_name = "your-keypair-name"

# Prefer your public IP/32 for SSH
ssh_ingress_cidr = "0.0.0.0/0"

# RDS master password — never commit terraform.tfvars
db_password = "change-me-strong-password"

# SNS alert email
alert_email = "you@example.com"

# EC2 deploy path (default: ec2-user ~/deploy)
deploy_path = "/home/ec2-user/deploy"
ec2_user    = "ec2-user"

# Optional sizing
ec2_instance_type = "t3.micro"
db_instance_class = "db.t4g.micro"
# db_name             = "afternote"
# db_username         = "afternote"

# Existing Elastic IP allocation ID (eipalloc-xxx), or "" to create new
existing_eip_allocation_id = ""

# off 01:00 KST, on 12:00 KST
stop_schedule     = "cron(0 1 * * ? *)"
start_schedule    = "cron(0 12 * * ? *)"
schedule_timezone = "Asia/Seoul"
